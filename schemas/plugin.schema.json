{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.macro-deck.app/store-plugin-v1.schema.json",
  "title": "Macro Deck Store Plugin",
  "type": "object",
  "required": [
    "$schema",
    "kind",
    "name",
    "id",
    "latestVersion",
    "description",
    "publisher",
    "createdAt",
    "updatedAt",
    "supportedRids"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "kind": { "const": "plugin" },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "id": { "$ref": "#/$defs/packageId" },
    "latestVersion": { "$ref": "#/$defs/semver" },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "publisher": { "type": "string", "minLength": 1, "maxLength": 128 },
    "repository": { "$ref": "#/$defs/httpsUrl" },
    "homepage": { "$ref": "#/$defs/httpsUrl" },
    "additionalLinks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/additionalLink" }
    },
    "license": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "supportedRids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(win|osx|linux(-musl)?)-(x64|arm64)$"
      }
    }
  },
  "$defs": {
    "packageId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\.[a-z][a-z0-9]*(-[a-z0-9]+)*)+$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "additionalLink": {
      "type": "object",
      "required": ["type", "url"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "url": { "type": "string", "format": "uri", "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://" },
        "label": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "custom" } } },
          "then": { "required": ["label"] }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "documentation",
                  "wiki",
                  "issues",
                  "support",
                  "community",
                  "donate",
                  "privacy",
                  "terms",
                  "changelog",
                  "license"
                ]
              }
            }
          },
          "then": { "not": { "required": ["label"] } }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
