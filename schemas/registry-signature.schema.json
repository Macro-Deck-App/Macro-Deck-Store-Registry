{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.macro-deck.app/store-registry-signature-v1.schema.json",
  "title": "Macro Deck Store Registry Signature",
  "description": "Detached signature over the exact UTF-8 bytes of registry-manifest.json.",
  "type": "object",
  "required": ["$schema", "schemaVersion", "algorithm", "keyId", "value", "signedAt"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "algorithm": { "const": "ed25519" },
    "keyId": {
      "description": "Certificate id under certificates/. The certificate must permit registry signing.",
      "type": "string",
      "pattern": "^cert_[0-9a-z]{16,64}$"
    },
    "value": {
      "description": "Raw 64-byte Ed25519 signature, base64.",
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    },
    "signedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
