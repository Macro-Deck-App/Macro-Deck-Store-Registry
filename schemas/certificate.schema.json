{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.macro-deck.app/store-certificate-v1.schema.json",
  "title": "Macro Deck Store Signing Certificate",
  "description": "Binds an Ed25519 key to a subject and an explicit signing purpose. The exact certificate bytes are signed by the Macro Deck root key in the sibling .sig file.",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "certificateId",
    "subject",
    "algorithm",
    "publicKey",
    "keyUsage",
    "notBefore",
    "notAfter",
    "issuedAt",
    "rootKeyId"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "certificateId": {
      "type": "string",
      "pattern": "^cert_[0-9a-z]{16,64}$"
    },
    "subject": {
      "type": "object",
      "required": ["kind", "id", "name"],
      "properties": {
        "kind": { "enum": ["creator", "organization", "service"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 450 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 }
      },
      "additionalProperties": false
    },
    "algorithm": { "const": "ed25519" },
    "publicKey": {
      "description": "Raw 32-byte Ed25519 public key, base64.",
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{43}=$"
    },
    "keyUsage": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["package", "registry"] }
    },
    "notBefore": { "type": "string", "format": "date-time" },
    "notAfter": { "type": "string", "format": "date-time" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "rootKeyId": {
      "type": "string",
      "pattern": "^root_[0-9a-z]{4,32}$"
    }
  },
  "additionalProperties": false
}
